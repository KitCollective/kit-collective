{
  "name": "kit-collective",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test --concurrency=1",
    "lint": "biome lint .",
    "lint:anti-slop": "oxlint",
    "format": "biome check --write .",
    "format:check": "biome ci .",
    "typecheck": "turbo run typecheck",
    "check:imports": "node scripts/check-import-boundaries.mjs",
    "check:seed-fkapi-tests": "node scripts/check-seed-fkapi-test-isolation.mjs",
    "check:mobile-tab-bar": "node scripts/check-mobile-tab-bar.mjs",
    "check:workflow-api-boot-env": "node scripts/check-workflow-api-boot-env.mjs",
    "check:coolify-seed-apify-compose": "node scripts/check-coolify-seed-apify-compose.mjs",
    "check:workflows": "bash scripts/lint-workflows.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@oxlint/plugins": "1.79.0",
    "oxlint": "1.79.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
