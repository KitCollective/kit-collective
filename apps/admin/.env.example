# Admin SPA (Vite). Points at the lane Nest API `/v1` base URL.
VITE_API_BASE_URL=http://127.0.0.1:3000/v1

# Social login GIS + Facebook OIDC dialog. Names only.
# Same web client / app as Nest verify; values live in GitHub Environments.
# VITE_FACEBOOK_REDIRECT_URI must match Nest FACEBOOK_REDIRECT_URI (Admin /login).
VITE_GOOGLE_CLIENT_ID=
VITE_FACEBOOK_APP_ID=
VITE_FACEBOOK_REDIRECT_URI=
