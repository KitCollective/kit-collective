# Linear admin key for scripts/bootstrap-linear.mjs only.
# Create in Linear → Settings → Security & access → Personal API keys.
# Scopes: Read, Write, Admin. Limit to team KIT after bootstrap.
# Never commit the real value. Never put this in Expo/Astro/client code.
LINEAR_API_KEY=

# Optional. Defaults to https://api.linear.app/graphql
# LINEAR_GRAPHQL_URL=

# -----------------------------------------------------------------------------
# Optional Pi harness Linear OAuth app (KIT-58). Not required for worker boot (KIT-113).
# When LINEAR_PI_ACCESS_TOKEN is set, implement/factory-checker stream a display-only
# Agent Session (thought / action / response) onto the issue timeline. Actor=app only —
# never LINEAR_CLI_API_KEY or LINEAR_API_KEY. Inbound /webhooks/linear/agent-session stays 404.
# Create in Linear → Settings → API → Applications. Install with actor=app.
# Scopes: read, write, app:assignable, app:mentionable. Not the admin scope.
# Do not put these on GitHub Environments development / staging / production.
# -----------------------------------------------------------------------------
# LINEAR_PI_APP_USER_ID=
# LINEAR_PI_CLIENT_ID=
# LINEAR_PI_CLIENT_SECRET=
# LINEAR_PI_ACCESS_TOKEN=
# LINEAR_PI_WEBHOOK_SECRET=
# LINEAR_PI_AGENT_SESSION_WEBHOOK_URL=https://harness.eskobar.dev/webhooks/linear/agent-session

# -----------------------------------------------------------------------------
# Factory worker (Cursor Issue Session Sandbox — replacing Pi harness)
# Pi harness archived: https://github.com/KitCollective/kit-pi-harness
# Env names for the new worker will land with factory-worker/ — not committed yet.
# Desktop / Cloud Agent: CURSOR_API_KEY in Cursor dashboard only.
# -----------------------------------------------------------------------------
# CURSOR_API_KEY=
# LINEAR_CLI_API_KEY=
# LINEAR_WEBHOOK_SECRET=
# GH_TOKEN=

# -----------------------------------------------------------------------------
# Lane secrets — GitHub Environments: development / staging / production
# -----------------------------------------------------------------------------
# Values live only in the matching GitHub Environment. Never commit real values.
# Never put production secrets in staging or development Environments.
# Clients (Expo, Astro, admin) must not import these; only Nest reads them at runtime.

# Postgres connection string for this lane's volume on the CX33 Coolify host.
DATABASE_URL=

# Unused by Nest Identity after the Auth session cutover. Do not mint product tokens with it.
JWT_SECRET=

# Better Auth (Nest Identity). Names only — values live in GitHub Environments.
# BETTER_AUTH_SECRET is required at Nest boot. BETTER_AUTH_URL is the public API origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
# BETTER_AUTH_API_KEY=  # dash/sentinel — documented for later Auth ops; not required to boot.

# Social login (Nest Identity). Names only — values live in GitHub Environments.
# Not fail-fast boot env; omit in CI docker smoke. Tests use the fake idToken verifier.
# GOOGLE_CLIENT_ID — Nest live Google idToken verify (audience).
# FACEBOOK_APP_ID — Nest live Facebook JWT audience (Limited Login + OIDC).
# FACEBOOK_APP_SECRET / FACEBOOK_REDIRECT_URI — Nest exchanges Admin OIDC authorization codes.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=
# ID_TOKEN_ADAPTER — omit or "fake" in tests; live only when a human sets it in GitHub Environments.
# ID_TOKEN_ADAPTER=
#
# Optional Expo public client ids (EAS channel / GitHub Environment). Not Nest boot env.
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_FACEBOOK_APP_ID=
# EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=
# Admin SPA GIS / Facebook OIDC dialog (apps/admin/.env). Not Nest boot env.
# VITE_GOOGLE_CLIENT_ID=
# VITE_FACEBOOK_APP_ID=
# VITE_FACEBOOK_REDIRECT_URI=

# Notify / SES — Identity asks Notify; it does not speak SES. Names only.
# MAILER_ADAPTER=ses  # omit or "fake" for the recording adapter (tests).
SES_FROM=
AWS_REGION=

# Redis broker for BullMQ job queues (Vision, wishlist, push). One instance per lane.
# Required in staging/production when workers run. CI/tests may omit (in-process fallback).
REDIS_URL=

# Gemini API key for Vision worker (Gemini 2.5 Flash-Lite). Nest only — never in clients.
# When unset, the Vision adapter no-ops and Save still succeeds.
GEMINI_API_KEY=

# Comma-separated browser origins for credentialed CORS (Expo Web, Astro, Admin SPA Vite).
# Required in production/staging GitHub Environments. Local dev defaults to common Expo Web and Admin Vite ports when unset.
CORS_ALLOWED_ORIGINS=

# Staging lane Postgres (seed CLI and Nest on staging). Falls back to DATABASE_URL when unset.
STAGING_DATABASE_URL=

# Cloudflare R2 object storage — one bucket per lane:
#   development → kc-development
#   staging     → kc-staging
#   production  → kc-production
# Scoped tokens must not open buckets outside their lane.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# -----------------------------------------------------------------------------
# Coolify MCP — Cursor only (not a GitHub Environment secret)
# -----------------------------------------------------------------------------
# Generate an API token in Coolify → Settings → API. Enable MCP in Settings → Advanced.
# Built-in MCP endpoint: {COOLIFY_API_URL}/mcp (Streamable HTTP, Bearer token).
#
# Cloud Agents: add COOLIFY_API_URL, COOLIFY_API_TOKEN, and optionally COOLIFY_MCP_URL
# as secrets on the kit-collective Cloud Agent environment. Install runs
# scripts/setup-coolify-mcp.sh, which generates .cursor/mcp.json from those names
# (does not copy .cursor/mcp.json.example). Desktop: generate via the same script or
# copy the example to .cursor/mcp.json. Never commit tokens.
# Panel URL includes port when non-standard (e.g. http://<cx33-host>:8000).
COOLIFY_API_URL=
COOLIFY_API_TOKEN=
# Optional. Defaults to {COOLIFY_API_URL}/mcp when unset.
COOLIFY_MCP_URL=
#
# Cloud Agents: register the same Coolify HTTP MCP under Cursor Dashboard → Integrations & MCP
# (name: coolify, URL: COOLIFY_MCP_URL, Authorization: Bearer <COOLIFY_API_TOKEN>). Repo mcp.json
# is generated by scripts/setup-coolify-mcp.sh for the IDE but does not alone satisfy GetMcpTools.

# Per-lane Coolify deploy webhook (GitHub Environment secret on staging / production).
# The URL is a bearer credential — store as a secret, not a variable.
COOLIFY_DEPLOY_WEBHOOK_URL=

# -----------------------------------------------------------------------------
# Seed MCP — Cursor server id kc_seed_mcp (not Coolify)
# -----------------------------------------------------------------------------
# Standalone stdio server in .cursor/mcp.json.example (`kc_seed_mcp`).
# Coolify MCP stays a separate server (host, databases, long one-shot jobs).
# Do not put COOLIFY_API_URL / COOLIFY_API_TOKEN / COOLIFY_MCP_URL on kc_seed_mcp.
# Uses lane secrets from above: DATABASE_URL, R2_* (development lane on chat Proof).
# Pass lane=staging in tool args only when the human names staging.
# Production is rejected by seed_apify / seed_fk.
#
SEED_STAGING_DATABASE_URL=
#
# APIFY_TOKEN — Apify API token for Opt-in Apify fetch (not the default Kader fetch path).
# GitHub Environment: development (and staging if you seed that lane). Never production.
APIFY_TOKEN=
#
# SEED_PROXY_URL — HTTP(S) proxy for live Transfermarkt / Football Kit Archive fetch.
# Residential: gate.decodo.com / country endpoints. Site Unblocker (ADR-0017): unblock.decodo.com:60000.
# Never commit real values. Coolify jobs require this (fail closed); Mac kc_seed_mcp may omit when not required.
SEED_PROXY_URL=
# SEED_REQUIRE_PROXY — when true, live fetch refuses without SEED_PROXY_URL.
SEED_REQUIRE_PROXY=
#
# FKAPI_BASE_URL — Football Kit Archive API base for seed_fk live listings (not fixture JSON).
# FKAPI_TOKEN — optional Bearer token when the FK origin requires auth.
FKAPI_BASE_URL=
FKAPI_TOKEN=
# CLI / CI fixtures (not required on kc_seed_mcp for live chat Proof):
# SEED_APIFY_FIXTURE — nested TransfermarktRawPayload JSON (hermetic CI / fixture adapter).
# SEED_APIFY_TEST_DATABASE_URL — disposable Postgres for @kit/seed-apify integration tests only (never the lane DATABASE_URL).
# SEED_KADER_HTML — recorded Transfermarkt HTML fixtures (kader adapter tests).
# SEED_FETCH — fetch backend: kader (default) or apify (opt-in; requires APIFY_TOKEN or SEED_APIFY_RECORDINGS).
# SEED_APIFY_RECORDINGS — recorded automation-lab actor dataset fixtures (requires SEED_FETCH=apify).
# SEED_APIFY_ACTOR_ID — optional override; defaults to automation-lab/transfermarkt-scraper.
# SEED_TRANSFERMARKT_REQUEST_DELAY_MS — ms between live Transfermarkt GETs (default 1500).
# SEED_TRANSFERMARKT_RETRY_MAX_ATTEMPTS — per-URL retries for HTTP 403/429 (default 3).
# SEED_TRANSFERMARKT_RETRY_BASE_DELAY_MS — base exponential backoff in ms (default 1000).
# SEED_TRANSFERMARKT_RATE_LIMIT_STOP_AFTER — consecutive exhausted 403/429 URLs before circuit open (default 3).
