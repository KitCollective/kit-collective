{
  "name": "@kit/seed-apify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "seed-apify": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "seed": "node dist/cli.js"
  },
  "dependencies": {
    "@kit/db": "workspace:*",
    "@kit/domain": "workspace:*",
    "@kit/seed-shared": "workspace:*",
    "apify-client": "^2.12.0",
    "cheerio": "^1.0.0",
    "drizzle-orm": "^0.39.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
