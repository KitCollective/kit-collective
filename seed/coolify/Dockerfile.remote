# Self-contained seed image for Coolify compose jobs (no local build context).
# Clones the public monorepo at build time so agents can deploy via Coolify API/MCP
# without checking out the repo on the CX33 host first.

ARG GIT_REPOSITORY=https://github.com/KitCollective/kit-collective.git
ARG GIT_REF=development

FROM node:22-bookworm-slim AS base
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && corepack enable

FROM base AS source
ARG GIT_REPOSITORY
ARG GIT_REF
RUN git clone --depth 1 --branch "${GIT_REF}" "${GIT_REPOSITORY}" .

FROM source AS deps
RUN pnpm install --frozen-lockfile

FROM deps AS build
RUN pnpm --filter @kit/seed-shared build \
  && pnpm --filter @kit/seed-apify build \
  && pnpm --filter @kit/seed-fkapi build \
  && pnpm --filter @kit/seed-mcp build

FROM base AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json ./package.json
COPY --from=deps /app/pnpm-lock.yaml ./pnpm-lock.yaml
COPY --from=deps /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=build /app/seed ./seed
COPY --from=deps /app/packages ./packages
COPY --from=deps /app/apps/api/package.json ./apps/api/package.json
