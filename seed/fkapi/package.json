{
  "name": "@kit/seed-fkapi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "kit-seed-fkapi": "./dist/cli.js"
  },
  "exports": {
    "./mapper": {
      "types": "./dist/mapper.d.ts",
      "import": "./dist/mapper.js"
    },
    "./object-store": {
      "types": "./dist/object-store.d.ts",
      "import": "./dist/object-store.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "import": "./dist/fetch.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "pnpm build && vitest run",
    "seed": "node dist/cli.js",
    "start:listing": "node dist/listing-http.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@kit/seed-shared": "workspace:*",
    "pg": "^8.13.1",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "drizzle-orm": "^0.39.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
