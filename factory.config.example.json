{
  "product": {
    "name": "Your Product",
    "workspaceMatch": "your product"
  },
  "approver": "Your Name",
  "github": {
    "ownerRepo": "org/repo"
  },
  "linear": {
    "teamKey": "ABC",
    "teamName": "Your Product",
    "delegateAgentName": "Cursor"
  },
  "lanes": {
    "integration": "development",
    "staging": "staging",
    "production": "production"
  },
  "dispatch": {
    "state": "To-do",
    "requireDelegate": false,
    "requireReadyForAgent": true,
    "requireUnblocked": true,
    "priorityOrder": [1, 2, 3, 4, 0]
  },
  "states": [
    { "name": "Backlog", "type": "backlog", "color": "#bec2c8" },
    { "name": "To-do", "type": "unstarted", "color": "#e2e2e2" },
    { "name": "Blocked", "type": "started", "color": "#eb5757" },
    { "name": "In Progress", "type": "started", "color": "#f2c94c" },
    { "name": "In Review", "type": "started", "color": "#5e6ad2" },
    { "name": "Approval", "type": "started", "color": "#26b5ce" },
    { "name": "Merging", "type": "started", "color": "#219653" },
    { "name": "Post-Merge", "type": "started", "color": "#0e7a5a" },
    { "name": "Done", "type": "completed", "color": "#4cb782" },
    { "name": "Canceled", "type": "canceled", "color": "#95a2b3" }
  ],
  "stateAliases": {
    "Todo": "To-do",
    "Cancelled": "Canceled"
  },
  "labels": {
    "groups": [
      { "name": "Triage", "color": "#eb5757", "description": "Who acts. Not dispatch." },
      { "name": "Spec", "color": "#9b51e0", "description": "Kickoff vs an existing project." },
      { "name": "Surface", "color": "#2f80ed", "description": "Which app surface a vertical slice touches. Not a horizontal split." },
      { "name": "Work", "color": "#56ccf2", "description": "Kind of work that is not a surface." },
      { "name": "Type", "color": "#bb87fc", "description": "Linear issue type. Do not invent extras." }
    ],
    "factory": [
      { "name": "signal-up", "group": "Triage", "color": "#f2994a", "description": "Out-of-scope finding. Human triage only." },
      { "name": "needs-triage", "group": "Triage", "color": "#eb5757", "description": "Waiting for a human before dispatch." },
      { "name": "needs-info", "group": "Triage", "color": "#f2c94c", "description": "Waiting on a human for missing information." },
      { "name": "proposal", "group": "Triage", "color": "#e99695", "description": "Out-of-scope feature or optimisation. Human triage only." },
      { "name": "ready-for-agent", "group": "Triage", "color": "#5e6ad2", "description": "Ticket is well-formed. Planner claims when status is dispatch.state, this label is present, and blockedBy is resolved." },
      { "name": "ready-for-human", "group": "Triage", "color": "#26b5ce", "description": "Blocked on a human decision." },
      { "name": "wontfix", "group": "Triage", "color": "#95a2b3", "description": "Will not be done." },
      { "name": "kickoff", "group": "Spec", "color": "#9b51e0", "description": "New Linear project from /to-spec kickoff." },
      { "name": "feature", "group": "Type", "color": "#27ae60", "description": "Feature spec against an existing project. Reuses Linear Feature." }
    ],
    "surfaces": [],
    "extra": [],
    "adopt": [
      { "name": "Bug", "group": "Type" },
      { "name": "Feature", "group": "Type" },
      { "name": "Improvement", "group": "Type" }
    ],
    "projects": {
      "groups": [
        { "name": "Craft", "color": "#f2c94c", "description": "PM filter on Linear projects. Not an issue split." }
      ],
      "items": [
        { "name": "craft:design", "group": "Craft", "color": "#e056a0", "description": "UI, layout, copy, a11y. Project filter only." },
        { "name": "craft:frontend", "group": "Craft", "color": "#2f80ed", "description": "Client surfaces. Project filter only." },
        { "name": "craft:backend", "group": "Craft", "color": "#27ae60", "description": "API and data. Project filter only." }
      ]
    }
  },
  "paths": {
    "helpers": ".cursor/agents",
    "setupFile": "linear.setup.json",
    "specs": ".scratch"
  },
  "checks": {
    "globalPaths": [
      "pnpm-lock.yaml",
      "package.json",
      "pnpm-workspace.yaml",
      "turbo.json",
      "tsconfig.base.json",
      "biome.json",
      ".nvmrc",
      ".node-version"
    ],
    "defaults": {
      "timeoutSeconds": 900
    },
    "suites": [
      {
        "id": "typecheck",
        "paths": [
          "apps/**",
          "packages/**",
          "tsconfig.base.json",
          "pnpm-lock.yaml"
        ],
        "command": "pnpm typecheck",
        "timeoutSeconds": 900
      },
      {
        "id": "factory-scripts",
        "paths": [
          "scripts/**",
          ".cursor/**",
          "factory.config.json"
        ],
        "command": "node --test scripts/tests/*.test.mjs",
        "timeoutSeconds": 600
      },
      {
        "id": "review-gate",
        "paths": [
          "apps/**",
          "packages/**",
          "scripts/**",
          "docs/**",
          "*.md",
          ".cursor/**"
        ],
        "command": "pnpm check:review-gate",
        "timeoutSeconds": 300
      },
      {
        "id": "domain",
        "paths": [
          "packages/domain/**"
        ],
        "command": "pnpm --filter ./packages/domain test",
        "timeoutSeconds": 600
      },
      {
        "id": "api-contract",
        "paths": [
          "packages/api-contract/**",
          "packages/domain/**"
        ],
        "command": "pnpm --filter ./packages/api-contract test",
        "timeoutSeconds": 600
      },
      {
        "id": "admin",
        "paths": [
          "apps/admin/**",
          "packages/api-contract/**",
          "packages/domain/**"
        ],
        "command": "pnpm --filter ./apps/admin test",
        "timeoutSeconds": 600
      },
      {
        "id": "mobile",
        "paths": [
          "apps/mobile/**",
          "packages/api-contract/**",
          "packages/domain/**"
        ],
        "command": "pnpm --filter ./apps/mobile test",
        "timeoutSeconds": 900
      },
      {
        "id": "db",
        "paths": [
          "packages/db/**",
          "packages/domain/**"
        ],
        "command": "pnpm --filter ./packages/db test",
        "timeoutSeconds": 900,
        "needs": [
          "postgres"
        ]
      },
      {
        "id": "api",
        "paths": [
          "apps/api/**",
          "packages/**"
        ],
        "command": "pnpm --filter ./apps/api test",
        "timeoutSeconds": 1800,
        "needs": [
          "postgres"
        ]
      }
    ]
  },
  "flow": {
    "runLog": ".factory/run-log.jsonl"
  },
  "agent": {
    "signalUpCapPerRun": 3,
    "workpadHeading": "## Agent Workpad"
  }
}
