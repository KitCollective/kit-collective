{
  "mcpServers": {
    "coolify": {
      "url": "${env:COOLIFY_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${env:COOLIFY_API_TOKEN}"
      }
    },
    "kc_seed_mcp": {
      "url": "${env:SEED_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${env:SEED_MCP_TOKEN}"
      }
    }
  }
}
