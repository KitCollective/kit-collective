{
	# HTTP/3 (QUIC) can abort large parallel JS loads in some browsers behind this proxy.
	servers {
		protocols h1 h2
	}
}

harness.eskobar.dev {
	reverse_proxy webhook:8080
}

# Optional — requires docker-compose.monitoring.yml and DNS A record for grafana.eskobar.dev.
grafana.eskobar.dev {
	reverse_proxy grafana:3000 {
		flush_interval -1
		header_up Host {host}
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Forwarded-For {remote_host}
	}
}
